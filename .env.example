# === Обязательные ===

# Токен бота — получить у @BotFather (/newbot или /token)
BOT_TOKEN=123456789:AAAA-your-token-here

# Telegram ID тренера (число!). Узнать свой ID: написать боту @userinfobot
ADMIN_ID=123456789

# === Необязательные ===

# Прокси для доступа к Telegram (пусто = прямое подключение).
# Можно указать НЕСКОЛЬКО вариантов через запятую — бот будет
# переключаться между ними при сбоях автоматически. Слово direct = без прокси.
#
# У Happ локальные порты по умолчанию: SOCKS5 10808, HTTP 10809.
# Happ должен быть ЗАПУЩЕН, системный VPN при этом не нужен.
# Проверить и подобрать рабочую комбинацию: python scripts/check_network.py
#
# пример (Happ запущен):
# PROXY_URL=socks5://127.0.0.1:10808, http://127.0.0.1:10809
# если прямой доступ к Telegram у провайдера НЕ заблокирован, можно
# добавить запасным вариантом слово direct: …, direct
PROXY_URL=

# API-ключи для роя моделей (команда /swarm) и эмбеддингов RAG.
# Достаточно GOOGLE_API_KEY (он же — эмбеддинги); QWEN_API_KEY опционален
# (запасной рой + запасной эмбеддер).
GOOGLE_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
QWEN_API_KEY=

# Эмбеддинги RAG (необязательно; по умолчанию авто-выбор по ключу:
# google gemini-embedding-001, dim=768; альтернатива: qwen text-embedding-v4)
# EMBEDDING_PROVIDER=google
# EMBEDDING_MODEL=gemini-embedding-001
# EMBEDDING_DIMENSION=768

# Путь к базе данных (по умолчанию bot.db; в Docker задаётся автоматически)
# DB_PATH=/app/data/bot.db
